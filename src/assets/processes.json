  {
    "id": "urban-forestry-3-30-300-analysis",
    "version": "1.0.0",
    "title": "Urban Forestry 3-30-300 Analysis",
    "description": "Evaluates urban green infrastructure according to the 3-30-300 rule. The process uses the spatial bounds derived from a GeoJSON area of interest to retrieve relevant public canopy and geospatial data. Optionally, it can incorporate user-provided tree canopy or green-area polygons that are not available in the public canopy dataset.",
    "topicName": "three-thirty-threehundred",
    "jobControlOptions": [
      "async-execute"
    ],
    "outputTransmission": [
      "reference"
    ],
    "keywords": [
      "urban-forestry",
      "canopy",
      "3-30-300",
      "geojson",
      "geotiff",
      "raster"
    ],
    "inputs": {
      "city": {
        "title": "City",
        "description": "The city for which the analysis is performed.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "string"
        }
      },
      "geojson": {
        "title": "Area of Interest",
        "description": "GeoJSON FeatureCollection containing one or more valid Polygon features defining the area of interest. The polygons do not need to be rectangular. The process derives the spatial bounds of this GeoJSON object to retrieve the relevant public data. Coordinates are expected in longitude-latitude order using WGS 84 / EPSG:4326.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "object",
          "required": [
            "type",
            "features"
          ],
          "properties": {
            "type": {
              "const": "FeatureCollection"
            },
            "features": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "geometry"
                ],
                "properties": {
                  "type": {
                    "const": "Feature"
                  },
                  "geometry": {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "const": "Polygon"
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Polygon linear rings. The first ring is the exterior boundary; any following rings represent holes.",
                        "items": {
                          "type": "array",
                          "minItems": 4,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "canopy_input": {
        "title": "Additional Canopy Input",
        "description": "Optional GeoJSON FeatureCollection containing one or more valid Polygon features representing additional tree canopy or green areas that are not available in the public canopy dataset. If present, the process reads the canopy height from the feature property specified by height_column; if that property is absent or invalid, default_height is used. Coordinates are expected in longitude-latitude order using WGS 84 / EPSG:4326.",
        "minOccurs": 0,
        "maxOccurs": 1,
        "schema": {
          "type": "object",
          "required": [
            "type",
            "features"
          ],
          "properties": {
            "type": {
              "const": "FeatureCollection"
            },
            "features": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "geometry",
                  "properties"
                ],
                "properties": {
                  "type": {
                    "const": "Feature"
                  },
                  "geometry": {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "const": "Polygon"
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Polygon linear rings. The first ring is the exterior boundary; any following rings represent holes.",
                        "items": {
                          "type": "array",
                          "minItems": 4,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 3,
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "properties": {
                    "type": "object",
                    "description": "Feature attributes. The attribute identified by height_column should contain the canopy height in metres.",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "height_column": {
        "title": "Canopy Height Attribute",
        "description": "Name of the canopy feature property containing the height value in metres. This value is used only when canopy_input is provided.",
        "minOccurs": 0,
        "maxOccurs": 1,
        "schema": {
          "type": "string",
          "default": "height"
        }
      },
      "default_height": {
        "title": "Default Canopy Height",
        "description": "Canopy height in metres used when a feature in canopy_input does not provide a valid value for the attribute specified by height_column.",
        "minOccurs": 0,
        "maxOccurs": 1,
        "schema": {
          "type": "number",
          "minimum": 0,
          "default": 15
        }
      }
    },
    "outputs": {
      "report_files": {
        "title": "3-30-300 Analysis Results",
        "description": "Object containing dynamic download links for the generated GeoTIFF raster layers.",
        "schema": {
          "type": "object",
          "properties": {
            "mediaType": {
              "type": "string",
              "example": "application/json"
            },
            "value": {
              "type": "object",
              "required": [
                "geoTiff"
              ],
              "properties": {
                "geoTiff": {
                  "type": "object",
                  "required": [
                    "three",
                    "thirty",
                    "threeHundred"
                  ],
                  "properties": {
                    "three": {
                      "type": "string",
                      "description": "Download URL for the 3-tree visibility raster.",
                      "example": "https://minio-proxy-dev.urbreath.tech/.../Leuven_rule_three_20260608_103750.tif"
                    },
                    "thirty": {
                      "type": "string",
                      "description": "Download URL for the 30 percent canopy-cover raster.",
                      "example": "https://minio-proxy-dev.urbreath.tech/.../Leuven_rule_thirty_20260608_103750.tif"
                    },
                    "threeHundred": {
                      "type": "string",
                      "description": "Download URL for the 300-metre proximity-to-green-space raster.",
                      "example": "https://minio-proxy-dev.urbreath.tech/.../Leuven_rule_threeHundred_20260608_103750.tif"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "id": "15minutescity",
    "title": "15-Minutes City Analysis",
    "description": "Accessibility analysis to evaluate 15-minute city conditions based on proximity to selected categories of points of interest.",
    "version": "1.0.0",
    "topicName": "15-minutes-city",
    "jobControlOptions": ["async-execute"],
    "outputTransmission": ["value", "reference"],
    "keywords": [
      "nbs",
      "accessibility",
