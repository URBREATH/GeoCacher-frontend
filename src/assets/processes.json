[
  {
    "id": "water-infiltration (This ID will be automatically overwritten by Kitsune)",
    "version": "1.0.0",
    "title": "Water Infiltration Analysis Preset",
    "description": "Analysis of stormwater runoff based on predefined weather scenarios using nature-based solutions (NBS).",
    "topicName": "water-infiltration",
    "jobControlOptions": [
      "async-execute"
    ],
    "outputTransmission": [
      "value",
      "reference"
    ],
    "keywords": ["nbs", "stormwater", "runoff", "infiltration", "water", "preset"],
    "inputs": {
      "mode": {
        "title": "Execution Mode",
        "description": "The mode of execution. Currently restricted to 'preset'.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "string",
          "default": "preset",
          "enum": ["preset"]
        }
      },
      "city": {
        "title": "City",
        "description": "The city for which the analysis is performed.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "string",
          "enum": [
            "Leuven",
            "Cluj-Napoca"
          ],
          "default": "Leuven",
          "example": {
            "value": "Leuven",
            "isPresent": true
          }
        }
      },
      "geojson": {
        "title": "GeoJSON",
        "description": "GeoJSON Feature representing the analysis area.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "object",
          "required": ["type", "geometry", "properties"],
          "properties": {
            "type": { "const": "Feature" },
            "geometry": {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "Polygon" },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": { "type": "number" }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "properties": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The identification name of the area."
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false,
          "example": {
            "value": {
              "type": "Feature",
              "geometry": {
                "type": "Polygon",
                "coordinates": [
                  [
                    [4.7001, 50.8790],
                    [4.7101, 50.8790],
                    [4.7101, 50.8850],
                    [4.7001, 50.8850],
                    [4.7001, 50.8790]
                  ]
                ]
              },
              "properties": {
                "name": "analysis-area-1"
              }
            },
            "isPresent": true
          }
        }
      },
      "weather": {
        "title": "Meteorological Scenario",
        "description": "Predefined weather conditions to be simulated.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "string",
          "enum": [
            "Normal Spring Day",
            "Summer Storm",
            "Extreme Event",
            "Winter Conditions"
          ]
        }
      },
      "nbs_weights": {
        "title": "NBS Weights",
        "description": "Dictionary of Nature-Based Solutions IDs with coverage percentages. The sum of values must be 100.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "existing_conditions": { "type": "number", "minimum": 0, "maximum": 100 },
            "rain_garden": { "type": "number", "minimum": 0, "maximum": 100 },
            "bioswale": { "type": "number", "minimum": 0, "maximum": 100 },
            "permeable_pavement": { "type": "number", "minimum": 0, "maximum": 100 },
            "green_roof_extensive": { "type": "number", "minimum": 0, "maximum": 100 },
            "constructed_wetland": { "type": "number", "minimum": 0, "maximum": 100 },
            "urban_forest": { "type": "number", "minimum": 0, "maximum": 100 },
            "infiltration_trench": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "example": {
            "value": {
              "bioswale": 70,
              "rain_garden": 30
            },
            "isPresent": true
          }
        }
      }
    },
    "outputs": {
      "infiltration_results": {
        "title": "Infiltration Analysis Results",
        "description": "The computed data showing water infiltration levels for the selected area and scenarios.",
        "schema": {
          "type": "object"
        }
      }
    }
  },
  {
