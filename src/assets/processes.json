      "poi",
      "osm",
      "urban",
      "mobility"
    ],
    "inputs": {
      "bbox": {
        "title": "Bounding Box",
        "description": "Bounding box defining the area of analysis, expressed as [minX, minY, maxX, maxY].",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          },
          "example": {
            "value": [4.682, 50.855, 4.732, 50.885],
            "isPresent": true
          }
        }
      },
      "output_options": {
        "title": "Output Options",
        "description": "Output format and coordinate reference system options.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "object",
          "properties": {
            "output_format": {
              "type": "string",
              "enum": ["csv", "geojson", "gpkg"]
            },
            "output_epsg": {
              "type": "string",
              "enum": ["4326", "3857", "3035"]
            }
          },
          "required": ["output_format", "output_epsg"],
          "oneOf": [
            {
              "properties": {
                "output_format": { "const": "geojson" },
                "output_epsg": { "const": "4326" }
              }
            },
            {
              "properties": {
                "output_format": { "const": "csv" },
                "output_epsg": { "enum": ["4326", "3857", "3035"] }
              }
            },
            {
              "properties": {
                "output_format": { "const": "gpkg" },
                "output_epsg": { "enum": ["4326", "3857", "3035"] }
              }
            }
          ],
          "example": {
            "value": {
              "output_format": "geojson",
              "output_epsg": "4326"
            },
            "isPresent": true
          }
        }
      },
      "poi_category_osm": {
        "title": "POI Categories",
        "description": "One or more OpenStreetMap POI categories to include in the 15-minute city accessibility analysis.",
        "minOccurs": 1,
        "maxOccurs": 1,
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Market and groceries",
              "Restaurants and cafés",
              "Education",
              "Health",
              "Banks and post offices",
              "Parks",
              "Entertainment",
              "Shops",
              "Public transport stops"
            ]
          },
          "example": {
            "value": ["Education", "Health", "Parks"],
            "isPresent": true
          }
        }
      }
    },
    "outputs": {
      "results": {
        "title": "15-Minutes City Analysis Results",
        "description": "Download URL of the output file stored on MinIO.",
        "schema": {
          "type": "object",
          "properties": {
            "mediaType": {
              "type": "string",
              "example": "application/json"
            },
            "value": {
              "type": "object",
              "required": ["download_url"],
              "properties": {
                "download_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Direct download link to the analysis output file on MinIO."
                }
              }
            }
          }
        }
      }
    }
  }
